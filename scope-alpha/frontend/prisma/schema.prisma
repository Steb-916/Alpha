generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Core Identity ─────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  displayName   String?
  slug          String?   @unique
  avatar        String?
  bio           String?

  provider      String    @default("credentials") // "credentials" | "google"
  tosAcceptedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  accounts     Account[]
  sessions     Session[]
  userSessions UserSession[]
  preferences  UserPreferences?
  watchlists   Watchlist[]
  alerts       Alert[]

  @@index([email])
  @@index([slug])
}

// ─── NextAuth ──────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Phase 7: JWT Session Tracking (device-level revocation) ───────────────

model UserSession {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique // JWT jti claim
  userAgent  String?
  ipAddress  String?
  lastActive DateTime  @default(now())
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ─── Platform Models (Era 2: Analytics) ────────────────────────────────────

model UserPreferences {
  id               String  @id @default(cuid())
  userId           String  @unique
  defaultAsset     String  @default("BTC")
  defaultTimeframe String  @default("1H")
  theme            String  @default("dark")
  savedLayouts     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("Default")
  assets    String[] @default([])
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Alert {
  id             String    @id @default(cuid())
  userId         String
  name           String
  asset          String
  type           String // "funding_rate" | "oi_change" | "liquidation" | "price" | "basis"
  condition      String // "above" | "below" | "crosses_above" | "crosses_below" | "change_exceeds"
  value          Float
  timeframe      String?
  isActive       Boolean   @default(true)
  lastTriggered  DateTime?
  triggerCount   Int       @default(0)
  deliveryMethod String    @default("in_app") // "in_app" | "email" | "telegram" | "webhook"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([asset, type, isActive])
}

model AlertHistory {
  id          String @id @default(cuid())
  alertId     String
  asset       String
  type        String
  condition   String
  threshold   Float
  actualValue Float

  triggeredAt DateTime @default(now())

  @@index([alertId, triggeredAt])
}

// ─── Phase 1: Historical market data ──────────────────────────────────────

model FundingRateSnapshot {
  id         String   @id @default(cuid())
  asset      String
  exchange   String
  rate       Float
  markPrice  Float
  indexPrice Float
  timestamp  DateTime
  createdAt  DateTime @default(now())

  @@unique([asset, exchange, timestamp])
  @@index([asset, timestamp])
  @@index([asset, exchange, timestamp])
}

model OISnapshot {
  id        String   @id @default(cuid())
  asset     String
  exchange  String
  oi        Float
  oiUsd     Float
  price     Float
  timestamp DateTime
  createdAt DateTime @default(now())

  @@unique([asset, exchange, timestamp])
  @@index([asset, timestamp])
}

model LiquidationEvent {
  id        String   @id @default(cuid())
  asset     String
  exchange  String
  side      String // "long" | "short" — side of the position that was liquidated
  quantity  Float
  price     Float
  usdValue  Float
  timestamp DateTime
  createdAt DateTime @default(now())

  @@index([asset, timestamp])
  @@index([asset, exchange, timestamp])
  @@index([timestamp])
}

model CandleHistory {
  id        String   @id @default(cuid())
  asset     String
  exchange  String
  timeframe String // "4h" | "1d"
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  timestamp DateTime
  createdAt DateTime @default(now())

  @@unique([asset, exchange, timeframe, timestamp])
  @@index([asset, timeframe, timestamp])
}
