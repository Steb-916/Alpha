generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Core Identity ─────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  displayName   String?
  slug          String?   @unique
  avatar        String?
  bio           String?

  provider      String    @default("credentials") // "credentials" | "google"
  tosAcceptedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  accounts     Account[]
  sessions     Session[]
  userSessions UserSession[]
  preferences  UserPreferences?
  watchlists   Watchlist[]
  alerts       Alert[]

  @@index([email])
  @@index([slug])
}

// ─── NextAuth ──────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Phase 7: JWT Session Tracking (device-level revocation) ───────────────

model UserSession {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique // JWT jti claim
  userAgent  String?
  ipAddress  String?
  lastActive DateTime  @default(now())
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ─── Platform Models (Era 2: Analytics) ────────────────────────────────────

model UserPreferences {
  id               String  @id @default(cuid())
  userId           String  @unique
  defaultAsset     String  @default("BTC")
  defaultTimeframe String  @default("1H")
  theme            String  @default("dark")
  savedLayouts     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("Default")
  assets    String[] @default([])
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Alert {
  id             String    @id @default(cuid())
  userId         String
  name           String
  asset          String
  type           String // "funding_rate" | "oi_change" | "liquidation" | "price" | "basis" | ...
  condition      String // "above" | "below" | "crosses_above" | "crosses_below" | "change_exceeds" | "changed"
  value          Float
  timeframe      String?
  isActive       Boolean   @default(true)
  lastTriggered  DateTime?
  triggerCount   Int       @default(0)
  deliveryMethod String    @default("in_app") // "in_app" | "email" | "telegram" | "webhook"

  /// Phase 5 Slice 3: durable per-alert state that survives Redis eviction.
  /// - For *_regime_change alerts: the last-observed regime string. First
  ///   observation seeds this column and does NOT fire — only transitions fire.
  /// - For whale_large_transfer alerts: the last-fired whale txHash. Dedupe
  ///   is on hash, not timestamp, so re-observations never re-fire.
  /// - Null for all other alert types.
  lastObservedState String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([asset, type, isActive])
}

model AlertHistory {
  id          String @id @default(cuid())
  alertId     String
  asset       String
  type        String
  condition   String
  threshold   Float
  actualValue Float

  triggeredAt DateTime @default(now())

  @@index([alertId, triggeredAt])
}

// ─── Phase 1: Historical market data ──────────────────────────────────────

model FundingRateSnapshot {
  id         String   @id @default(cuid())
  asset      String
  exchange   String
  rate       Float
  markPrice  Float
  indexPrice Float
  timestamp  DateTime
  createdAt  DateTime @default(now())

  @@unique([asset, exchange, timestamp])
  @@index([asset, timestamp])
  @@index([asset, exchange, timestamp])
}

model OISnapshot {
  id        String   @id @default(cuid())
  asset     String
  exchange  String
  oi        Float
  oiUsd     Float
  price     Float
  timestamp DateTime
  createdAt DateTime @default(now())

  @@unique([asset, exchange, timestamp])
  @@index([asset, timestamp])
}

model LiquidationEvent {
  id        String   @id @default(cuid())
  asset     String
  exchange  String
  side      String // "long" | "short" — side of the position that was liquidated
  quantity  Float
  price     Float
  usdValue  Float
  timestamp DateTime
  createdAt DateTime @default(now())

  @@index([asset, timestamp])
  @@index([asset, exchange, timestamp])
  @@index([timestamp])
}

model CandleHistory {
  id        String   @id @default(cuid())
  asset     String
  exchange  String
  timeframe String // "4h" | "1d"
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  timestamp DateTime
  createdAt DateTime @default(now())

  @@unique([asset, exchange, timeframe, timestamp])
  @@index([asset, timeframe, timestamp])
}

// ─── Phase 2: Health score snapshots for trend + sparkline rendering ──────

model HealthScoreSnapshot {
  id          String   @id @default(cuid())
  asset       String
  score       Float
  regime      String
  funding     Float
  oi          Float
  liquidation Float
  basis       Float
  timestamp   DateTime
  createdAt   DateTime @default(now())

  @@unique([asset, timestamp])
  @@index([asset, timestamp])
}

// ─── Phase 3: Options + volatility snapshots ──────────────────────────────

/// One row per option instrument per snapshot cycle. Hourly granularity.
model OptionsChainSnapshot {
  id              String   @id @default(cuid())
  asset           String                 // "BTC" or "ETH"
  instrumentName  String                 // "BTC-28MAR26-90000-C"
  strike          Float
  expiration      DateTime
  optionType      String                 // "call" or "put"

  markPrice       Float                  // In USD (converted from native)
  markIV          Float                  // Annualized %, Deribit scale (0-500)
  bidIV           Float?
  askIV           Float?
  underlyingPrice Float

  openInterest    Float
  volume24h       Float

  delta           Float?
  gamma           Float?
  vega            Float?
  theta           Float?

  timestamp       DateTime
  createdAt       DateTime @default(now())

  @@unique([asset, instrumentName, timestamp])
  @@index([asset, timestamp])
  @@index([asset, expiration, timestamp])
  @@index([asset, strike, optionType, timestamp])
}

/// Computed vol surface output from the Quant Engine.
model VolSurfaceSnapshot {
  id          String   @id @default(cuid())
  asset       String
  surfaceData Json                       // Array of {strike, expiry, fittedIV, delta}
  atmIV30d    Float?
  atmIV90d    Float?
  skew25d30d  Float?

  timestamp   DateTime
  createdAt   DateTime @default(now())

  @@unique([asset, timestamp])
  @@index([asset, timestamp])
}

/// Historical IV snapshots for term structure, VRP tracking, and screener.
model IVSnapshot {
  id          String   @id @default(cuid())
  asset       String
  iv7d        Float?
  iv30d       Float?
  iv60d       Float?
  iv90d       Float?
  iv180d      Float?
  skew25d7d   Float?
  skew25d30d  Float?
  skew25d90d  Float?
  spotPrice   Float

  timestamp   DateTime
  createdAt   DateTime @default(now())

  @@unique([asset, timestamp])
  @@index([asset, timestamp])
}

/// Hourly GEX snapshots — used to power the GEX heatmap over time and
/// gamma-regime tracking. `levelsData` is the full strike→GEX array so the
/// heatmap renderer can resurrect the per-strike profile at any point.
model GEXSnapshot {
  id          String   @id @default(cuid())
  asset       String

  gammaFlip   Float
  totalGex    Float
  regime      String
  callWall    Float
  putWall     Float

  levelsData  Json

  spotPrice   Float
  timestamp   DateTime
  createdAt   DateTime @default(now())

  @@unique([asset, timestamp])
  @@index([asset, timestamp])
}

/// ─── Phase 5 — On-chain analytics ─────────────────────────────────────────
///
/// Daily snapshot of the core on-chain indicators per asset. Raw values come
/// from the provider (CoinMetrics community in v1); derived values come from
/// the Quant Engine (MVRV z-score, SOPR state, NVT regime, etc.).
model OnChainSnapshot {
  id              String   @id @default(cuid())
  asset           String
  timestamp       DateTime

  marketCapUsd    Float?
  realizedCapUsd  Float?
  supplyNative    Float?
  activeAddresses Int?
  txCount         Int?
  txVolumeUsd     Float?
  feesUsd         Float?

  mvrv            Float?
  mvrvZScore      Float?
  mvrvRegime      String?
  sopr            Float?
  soprState       String?
  nvt             Float?
  nvtRegime       String?

  createdAt       DateTime @default(now())

  @@unique([asset, timestamp])
  @@index([asset, timestamp])
}

/// Per-exchange netflow slice (daily). v1 populates aggregate-only (exchange =
/// "aggregate") from CoinMetrics FlowInExUSD/FlowOutExUSD; per-exchange
/// breakdown arrives when an upgraded provider (Glassnode/Arkham) is wired in.
model ExchangeFlowSnapshot {
  id          String   @id @default(cuid())
  asset       String
  exchange    String
  netFlowUsd  Float
  inflowUsd   Float
  outflowUsd  Float
  timestamp   DateTime
  createdAt   DateTime @default(now())

  @@unique([asset, exchange, timestamp])
  @@index([asset, timestamp])
}

/// Rolling log of large on-chain transfers. Populated by the whale poller
/// (Slice 2). Retention policy: 90 days — pruning handled by a periodic job
/// (not implemented in v1; table will accumulate until the first retention
/// pass lands).
model WhaleTransaction {
  id             String   @id @default(cuid())
  asset          String
  valueUsd       Float
  fromAddress    String
  toAddress      String
  fromLabel      String?
  toLabel        String?
  classification String
  txHash         String
  timestamp      DateTime
  createdAt      DateTime @default(now())

  @@unique([txHash])
  @@index([asset, timestamp])
  @@index([classification, timestamp])
}

/// Stablecoin aggregate (USDT + USDC + DAI) daily. Populated by the
/// DefiLlama provider (Slice 2).
model StablecoinSnapshot {
  id                 String   @id @default(cuid())
  timestamp          DateTime @unique
  totalSupplyUsd     Float
  exchangeBalanceUsd Float
  exchangeBalancePct Float
  usdtSupplyUsd      Float
  usdcSupplyUsd      Float
  daiSupplyUsd       Float
  createdAt          DateTime @default(now())

  @@index([timestamp])
}

/// ─── Phase 6 Slice 1 — Regime classifier ──────────────────────────────────
///
/// One row per asset per hour. `rawClassification` is what the rules
/// produced this hour; `committedRegime` is what's persisted after the
/// 2-of-2 persistence filter (with the `capitulation` instant-commit
/// exception). `regimeChanged` is true when the committed regime differs
/// from the previous row's committed regime — used by `regime_change`
/// alerts via Alert.lastObservedState.
model RegimeSnapshot {
  id                String   @id @default(cuid())
  asset             String
  timestamp         DateTime

  rawClassification String
  committedRegime   String
  regimeChanged     Boolean  @default(false)
  prevRegime        String?

  confidence        Float
  /// RegimeFeatureVector serialized — full snapshot for debugging + UI.
  featureVector     Json
  /// { supporting: string[], neutral: string[], conflicting: string[] }
  featureSupport    Json

  createdAt         DateTime @default(now())

  @@unique([asset, timestamp])
  @@index([asset, timestamp])
  @@index([committedRegime, timestamp])
}
